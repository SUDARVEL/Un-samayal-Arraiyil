{
  "expo": {
    "name": "Samayal Arayayil",
    "slug": "Un-samayal-Arraiyil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.samayal.arayayil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.samayal.arayayil"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "scheme": "samayal",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7603f568-0327-435e-8992-37b84263beb9"
      }
    },
    "owner": "sudarvel1234",
    "updates": {
      "url": "https://u.expo.dev/7603f568-0327-435e-8992-37b84263beb9"
    }
  }
}
